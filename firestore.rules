rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasVerifiedWhatsAppPhone() {
      let verifiedPhonePath = /databases/$(database)/documents/verifiedWhatsAppPhones/$(request.auth.uid);
      return request.auth != null
        && exists(verifiedPhonePath)
        && get(verifiedPhonePath).data.phone == request.resource.data.customerPhone
        && get(verifiedPhonePath).data.expiresAt > request.time;
    }

    // Bikes collection
    match /bikes/{bikeId} {
      allow get: if isValidId(bikeId);
      allow list: if true;
      allow create, update, delete: if isValidId(bikeId);
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId);
      allow list: if true;
      allow create: if isValidId(bookingId)
        && bookingId != 'book-1793009088589'
        && hasVerifiedWhatsAppPhone();
      allow update: if isValidId(bookingId)
        && bookingId != 'book-1793009088589'
        && (
          request.resource.data.customerPhone == resource.data.customerPhone
          || hasVerifiedWhatsAppPhone()
        );
      allow delete: if isValidId(bookingId);
    }

    // Expenses collection
    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId);
      allow list: if true;
      allow create, update, delete: if isValidId(expenseId);
    }

    // Financial settings collection
    match /financial_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isValidId(settingId);
    }
  }
}
